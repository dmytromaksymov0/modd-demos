---
import BaseLayout from '../layouts/BaseLayout.astro';
import FacadeHero from '../components/patterns/FacadeHero.astro';
import RepairChat from '../components/home/RepairChat.astro';
import CalcMini from '../components/home/CalcMini.astro';
import Services from '../components/home/Services.astro';
import PriceHow from '../components/home/PriceHow.astro';
import PowerSection from '../components/home/PowerSection.astro';
import Masters from '../components/home/Masters.astro';
import Booking from '../components/home/Booking.astro';
import { faqSchema } from '../lib/schema.ts';
import { homeFaq } from '../data/faq.ts';
---
<BaseLayout heroFont og="home" schema={faqSchema(homeFaq)} title="ТОРК Автосервіс — СТО на Салтівці, Харків · кошторис до ремонту"
  description="Автосервіс на Салтівці з 2014, 7 хв від м. Студентська. Діагностика, ходова, гальма, ТО, кондиціонер. Кошторис у Telegram до ремонту, гарантія 12 міс / 10 000 км.">
  <div class="wrap pb-section pt-6 md:pt-8"><FacadeHero /></div>
  <RepairChat />
  <CalcMini />
  <Services />
  <PriceHow />
  <PowerSection />
  <Masters />
  <Booking />
</BaseLayout>
<script>
  // Interactive estimate + calculator load on the first interaction; until then everything is plain HTML.
  let ready = false, loading: Promise<void> | null = null, pending: HTMLElement | null = null;
  const load = () => (loading ??= import('../lib/home-ui').then((m) => { m.init(); ready = true; pending?.click(); pending = null; }));
  for (const ev of ['pointerdown', 'keydown', 'focusin', 'touchstart'] as const) addEventListener(ev, load, { once: true, passive: true, capture: true });
  addEventListener('change', load, { once: true, capture: true });
  addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-approve], [data-calc-book]');
    if (t && !ready) { pending = t; load(); }
  }, { capture: true });
</script>
