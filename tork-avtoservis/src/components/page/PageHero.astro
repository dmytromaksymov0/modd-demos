---
// Inner-page hero in the facade language: main window (breadcrumbs, H1, lead, CTA) + a photo window
// + an optional fact strip. Every photo caption must describe what is in the frame.
import type { ImageMetadata } from 'astro';
import Photo from '../ui/Photo.astro';
import Plate from '../ui/Plate.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site.ts';
interface Crumb { label: string; href?: string }
interface Props {
  crumbs: Crumb[]; title: string; lead: string;
  photo?: { src: ImageMetadata; alt: string; position?: string; plate?: string };
  facts?: { label: string; value: string }[];
  cta?: { label: string; href: string } | false;
}
const { crumbs, title, lead, photo, facts = [], cta = { label: 'Записатися', href: '#zapys' } } = Astro.props;
const factCols: Record<number, string> = { 1: '', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3', 4: 'sm:grid-cols-4' };
---
<div class="wrap pb-section pt-6 md:pt-8">
  <div class={`facade grid-cols-1 ${photo ? 'lg:grid-cols-12' : ''}`} data-hero>
    <div class={`window flex flex-col gap-5 p-5 sm:p-7 lg:p-8 ${photo ? 'lg:col-span-7' : ''}`}>
      <nav aria-label="Ви тут" class="t-plate text-glass-deep">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          {crumbs.map((c, i) => <li class="flex items-center gap-2">{i > 0 && <span aria-hidden="true">/</span>}{c.href ? <a href={c.href} class="-my-2.5 inline-flex min-h-11 items-center underline-offset-4 hover:underline">{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
      <h1 class="t-h1 max-w-[16ch] text-[clamp(2rem,1.2rem+3.6vw,4.25rem)]!" set:html={title} />
      <p class="t-lead measure">{lead}</p>
      {cta && (
        <div class="mt-auto grid gap-3 pt-2 sm:flex sm:flex-wrap sm:items-center">
          <Button href={cta.href} size="lg" data-hero-cta><Icon name="calendar" class="size-5 max-sm:hidden" />{cta.label}</Button>
          <div class="grid grid-cols-2 gap-2.5 sm:flex">
            <Button href={site.channels.telegram.href} variant="secondary" size="sm"><Icon name="send" class="size-4" />Telegram</Button>
            <Button href={site.channels.viber.href} variant="secondary" size="sm"><Icon name="message" class="size-4" />Viber</Button>
          </div>
        </div>
      )}
    </div>
    {photo && (
      <figure class="window relative min-h-64 sm:min-h-80 lg:col-span-5 lg:min-h-0 [&_img]:absolute [&_img]:inset-0">
        <Photo src={photo.src} alt={photo.alt} sizes="(min-width: 86rem) 540px, (min-width: 64rem) 40vw, calc(100vw - 2.75rem)" widths={[360, 540, 720, 1080]} quality={50} position={photo.position} priority />
        {photo.plate && <figcaption class="absolute bottom-0 left-0"><Plate tone="steel" role={photo.plate} class="!py-1.5" /></figcaption>}
      </figure>
    )}
    {facts.length > 0 && (
      <dl class={`window grid grid-cols-2 gap-px bg-steel! p-0 ${factCols[Math.min(facts.length, 4)]} ${photo ? 'lg:col-span-12' : ''}`}>
        {facts.map((f) => <div class="bg-paper p-4"><dt class="t-plate text-glass-deep">{f.label}</dt><dd class="mt-1 font-display text-[clamp(1.0625rem,0.9rem+0.8vw,1.375rem)] font-[850] [font-variation-settings:'wdth'_64] tabular-nums">{f.value}</dd></div>)}
      </dl>
    )}
  </div>
</div>
