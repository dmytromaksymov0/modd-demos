---
// How the price is made: formula, parts options, payment — before the visit, without small print.
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import { carClasses } from '../../config/site.ts';
import { fmtMoney } from '../../lib/calc.ts';
const parts = [
  { t: 'Наші запчастини', d: 'Оригінал або перевірений аналог — на вибір, з артикулом у кошторисі. Гарантія на роботу й деталь.' },
  { t: 'Ваші запчастини', d: 'Привезли свої — ставимо. Гарантія на роботу; на деталь — від продавця.' },
  { t: 'Старі деталі', d: 'Не викидаємо: віддаємо вам у пакеті з номером замовлення.' },
];
---
<section id="tsina" class="border-t-2 border-steel" aria-labelledby="price-title">
  <div class="wrap py-section">
    <SectionHead id="price-title" kicker="Ціна" title="Як складається сума в&nbsp;чеку" />
    <div class="facade mt-10 grid-cols-1 lg:grid-cols-12">
      <div class="window grid gap-6 p-5 sm:p-7 lg:col-span-7">
        <p class="t-h2">Робота = нормо-година класу × норматив</p>
        <p class="measure">Норматив — скільки часу займає робота за довідником виробника. Нормо-година залежить від класу авто: на Land Cruiser та сама робота довша, ніж на Lanos.</p>
        <dl class="grid grid-cols-2 gap-1.5 bg-steel p-1.5 sm:grid-cols-4">
          {carClasses.map((c) => (
            <div class="bg-paper p-3"><dt class="t-plate">Клас {c.label}</dt><dd class="mt-1 font-display text-[1.625rem] font-[850] [font-variation-settings:'wdth'_70] num">{fmtMoney(c.rate)}</dd><dd class="text-label text-glass-deep">{c.examples}</dd></div>
          ))}
        </dl>
        <a href="/tsiny/" class="inline-flex min-h-11 w-fit items-center gap-2 font-semibold underline decoration-ochre decoration-2 underline-offset-4">Повний прайс за класами<Icon name="arrow-right" class="size-4" /></a>
      </div>
      <ul class="window grid content-start gap-0 lg:col-span-5">
        {parts.map((p) => <li class="border-b-2 border-steel p-5 last:border-b-0"><b class="t-h3 block">{p.t}</b><p class="mt-1.5 t-small">{p.d}</p></li>)}
      </ul>
      <div class="window grid gap-3 bg-ochre! p-5 sm:p-7 lg:col-span-12 lg:grid-cols-[auto_1fr_1fr_1fr] lg:items-center lg:gap-8">
        <p class="t-plate">Оплата</p>
        <p class="flex items-center gap-2 font-semibold"><Icon name="credit-card" />Картка або готівка</p>
        <p class="flex items-center gap-2 font-semibold"><Icon name="package" />Рахунок для ФОП/ТОВ + акт виконаних робіт</p>
        <p class="flex items-center gap-2 font-semibold"><Icon name="check" />Платите лише за погоджене</p>
      </div>
    </div>
  </div>
</section>
