---
// Car class picker for prices and the calculator. Buttons with aria-pressed; all four cards share one height and top edge
// (the earlier A → D «towers» read as misalignment in review, 22.10.2026).
import { carClasses } from '../../config/site';
interface Props { selected?: string; name?: string }
const { selected = 'B' } = Astro.props;
---
<div class="grid auto-rows-fr grid-cols-2 gap-1.5 sm:grid-cols-4" role="group" aria-label="Клас авто">
  {carClasses.map((c) => (
    <button type="button" class="cls flex min-h-16 flex-col items-start justify-start border-2 border-steel bg-paper px-3 pb-2 pt-3 text-left aria-pressed:bg-ochre" aria-pressed={c.id === selected ? 'true' : 'false'} data-class={c.id}>
      <b class="font-display text-[1.375rem] leading-none font-[850] [font-variation-settings:'wdth'_60]">Клас {c.label}</b>
      <span class="mt-1 text-label leading-snug">{c.examples}</span>
    </button>
  ))}
</div>
