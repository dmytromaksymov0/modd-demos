---
// Section 5 — argument #2: real numbers. Mini calculator (6/12 pitch assumed) + price-lock promises.
import { estimate, RATES, usd } from '../../lib/pricing';
import { site } from '../../config/site';
import Button from '../ui/Button.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Lock from '@lucide/astro/icons/lock';
import Camera from '@lucide/astro/icons/camera';
import CircleDollarSign from '@lucide/astro/icons/circle-dollar-sign';
const d = estimate({ homeSqft: 2000, stories: 2, pitch: 6, material: 'architectural' });
---
<section class="border-t border-line py-[var(--spacing-section)]" aria-labelledby="price-title" data-mini-calc data-rates={JSON.stringify(RATES)}>
  <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <p class="t-label text-graphite">What it costs</p>
      <h2 id="price-title" class="t-h2 mt-2">Real numbers, before anyone climbs a ladder.</h2>
      <p class="t-lead measure mt-4 text-graphite">Most roofers won’t put a price online. Here’s ours for a typical Columbus home. The inspection turns the range into one fixed number.</p>
      <ul class="mt-8 flex flex-col gap-5">
        <li class="flex gap-3"><Lock class="mt-1 size-5 shrink-0 text-blueprint" aria-hidden="true" /><span><b>Price locked before we start.</b> <span class="text-graphite">The number on your estimate is the number on your invoice.</span></span></li>
        <li class="flex gap-3"><Camera class="mt-1 size-5 shrink-0 text-blueprint" aria-hidden="true" /><span><b>Rotten decking: $85 a sheet.</b> <span class="text-graphite">Only with a photo of the sheet and your OK.</span></span></li>
        <li class="flex gap-3"><CircleDollarSign class="mt-1 size-5 shrink-0 text-blueprint" aria-hidden="true" /><span><b>0% for {site.financing.months} months.</b> <span class="text-graphite">{site.financing.note}</span></span></li>
      </ul>
    </div>

    <form class="rounded-sm border border-ink bg-white lg:col-span-7" onsubmit="return false" aria-label="Quick roof price estimate">
      <div class="grid gap-6 p-5 md:p-7">
        <div>
          <div class="flex items-baseline justify-between gap-4">
            <label for="mc-size" class="t-label text-graphite">Home size</label>
            <output for="mc-size" class="text-h3 font-bold [font-variation-settings:'wdth'_115]" data-out-size>2,000 sq ft</output>
          </div>
          <input id="mc-size" type="range" min="1000" max="4500" step="100" value="2000" class="range mt-3 w-full" data-size aria-valuetext="2,000 square feet" />
          <div class="t-label mt-1 flex justify-between text-graphite"><span>1,000</span><span>4,500</span></div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          <fieldset>
            <legend class="t-label mb-2 text-graphite">Stories</legend>
            <div class="seg grid grid-cols-2">
              <label><input type="radio" name="mc-stories" value="1" class="peer sr-only" /><span>One</span></label>
              <label><input type="radio" name="mc-stories" value="2" checked class="peer sr-only" /><span>Two</span></label>
            </div>
          </fieldset>
          <fieldset>
            <legend class="t-label mb-2 text-graphite">Material</legend>
            <div class="seg grid grid-cols-2">
              <label><input type="radio" name="mc-material" value="architectural" checked class="peer sr-only" /><span>Shingle</span></label>
              <label><input type="radio" name="mc-material" value="metal" class="peer sr-only" /><span>Metal</span></label>
            </div>
          </fieldset>
        </div>
      </div>
      <div class="border-t border-ink bg-ink p-5 text-paper md:p-7" aria-live="polite">
        <p class="t-label text-mist">Estimated price, installed</p>
        <p class="mt-1 text-[clamp(1.875rem,1.4rem+2.6vw,3.5rem)] font-bold leading-none [font-variation-settings:'wdth'_120]" data-out-price>{usd(d.low)} – {usd(d.high)}</p>
        <dl class="mt-5 grid grid-cols-3 gap-4 border-t border-ink-2 pt-4">
          <div><dt class="t-label text-mist">Roof size</dt><dd class="mt-1 font-semibold" data-out-squares>{d.squares} squares</dd></div>
          <div><dt class="t-label text-mist">Time</dt><dd class="mt-1 font-semibold" data-out-days>{d.days} {d.days === 1 ? 'day' : 'days'}</dd></div>
          <div><dt class="t-label text-mist">At 0% / 12 mo</dt><dd class="mt-1 font-semibold" data-out-monthly>≈ {usd(d.monthly)}/mo</dd></div>
        </dl>
        <p class="t-small mt-4 text-mist">Assumes a medium 6/12 pitch and tear-off of one layer. Your roof’s pitch and details change the number — the full calculator lets you pick yours from photos.</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
          <Button href="#final-form" data-set-problem="old-roof">Get my exact price — free</Button>
          <a href="/roof-cost-calculator/" class="inline-flex min-h-11 items-center gap-1.5 font-semibold text-paper underline underline-offset-4 hover:text-blueprint-light">Full calculator <ArrowRight class="size-4" aria-hidden="true" /></a>
        </div>
      </div>
    </form>
  </div>
</section>

<style>
  .seg { border: 1px solid var(--color-line); border-radius: var(--radius-sm); }
  .seg label { position: relative; }
  .seg span { display: flex; min-height: 3rem; align-items: center; justify-content: center; font-weight: 600; cursor: pointer; transition: background-color var(--duration-fast); }
  .seg label + label span { border-left: 1px solid var(--color-line); }
  .seg input:checked + span { background: var(--color-ink); color: var(--color-paper); }
  .seg input:focus-visible + span { outline: 3px solid var(--color-blueprint); outline-offset: 2px; }
  .range { appearance: none; height: 2.75rem; background: transparent; cursor: pointer; }
  .range::-webkit-slider-runnable-track { height: 4px; background: linear-gradient(var(--color-blueprint), var(--color-blueprint)) 0 / var(--fill, 29%) 100% no-repeat, var(--color-line); border-radius: 2px; }
  .range::-moz-range-track { height: 4px; background: var(--color-line); border-radius: 2px; }
  .range::-moz-range-progress { height: 4px; background: var(--color-blueprint); }
  .range::-webkit-slider-thumb { appearance: none; width: 28px; height: 28px; margin-top: -12px; border-radius: 50%; background: var(--color-white); border: 2px solid var(--color-ink); }
  .range::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: var(--color-white); border: 2px solid var(--color-ink); }
  .range:focus-visible { outline: none; }
  .range:focus-visible::-webkit-slider-thumb { outline: 3px solid var(--color-blueprint); outline-offset: 2px; }
  .range:focus-visible::-moz-range-thumb { outline: 3px solid var(--color-blueprint); outline-offset: 2px; }
</style>

<script>
  import { estimate, usd, type Material } from '../../lib/pricing';
  document.querySelectorAll<HTMLElement>('[data-mini-calc]').forEach((root) => {
    const size = root.querySelector<HTMLInputElement>('[data-size]')!;
    const $ = (s: string) => root.querySelector<HTMLElement>(s)!;
    const update = () => {
      const homeSqft = Number(size.value);
      const stories = Number(root.querySelector<HTMLInputElement>('input[name="mc-stories"]:checked')!.value) as 1 | 2;
      const material = root.querySelector<HTMLInputElement>('input[name="mc-material"]:checked')!.value as Material;
      const e = estimate({ homeSqft, stories, pitch: 6, material });
      const sq = homeSqft.toLocaleString('en-US');
      $('[data-out-size]').textContent = `${sq} sq ft`;
      size.setAttribute('aria-valuetext', `${sq} square feet`);
      size.style.setProperty('--fill', `${((homeSqft - 1000) / 3500) * 100}%`);
      $('[data-out-price]').textContent = `${usd(e.low)} – ${usd(e.high)}`;
      $('[data-out-squares]').textContent = `${e.squares} squares`;
      $('[data-out-days]').textContent = `${e.days} ${e.days === 1 ? 'day' : 'days'}`;
      $('[data-out-monthly]').textContent = `≈ ${usd(e.monthly)}/mo`;
    };
    root.addEventListener('input', update);
    update();
  });
</script>
