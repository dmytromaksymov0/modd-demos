---
// Inner-page hero: kicker, H1, lede, primary action + call, annotated photo. Annotations go in the default slot.
import type { ImageMetadata } from 'astro';
import { site } from '../../config/site';
import AnnotatedPhoto from '../ui/AnnotatedPhoto.astro';
import Button from '../ui/Button.astro';
import Phone from '@lucide/astro/icons/phone';
interface Props { kicker: string; title: string; lede: string; img: ImageMetadata; alt: string; position?: string; cta?: { label: string; href: string; problem?: string } }
const { kicker, title, lede, img, alt, position = '50% 50%', cta = { label: 'Book a free inspection', href: '#final-form' } } = Astro.props;
---
<section class="wrap grid gap-6 pt-8 pb-12 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-12 lg:pb-16" data-hero>
  <div class="flex flex-col gap-5 lg:col-span-6">
    <p class="t-label text-graphite">{kicker}</p>
    <h1 class="t-h1" set:html={title} />
    <p class="t-lead measure text-graphite">{lede}</p>
    <div class="flex flex-wrap gap-2">
      <Button href={cta.href} data-set-problem={cta.problem}>{cta.label}</Button>
      <Button href={site.phone.href} variant="secondary"><Phone class="size-5" aria-hidden="true" />{site.phone.display}</Button>
    </div>
    <slot name="after-cta" />
  </div>
  <div class="lg:col-span-6">
    <AnnotatedPhoto src={img} alt={alt} priority quality={55} position={position} sizes="(min-width: 1344px) 640px, (min-width: 1024px) 48vw, calc(100vw - 32px)">
      <slot />
    </AnnotatedPhoto>
  </div>
</section>
