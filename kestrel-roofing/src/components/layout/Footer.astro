---
import { site, nav, serviceArea } from '../../config/site';
import Logo from '../brand/Logo.astro';
import OpenStatus from './OpenStatus.astro';
const year = new Date().getFullYear();
---
<footer class="border-t border-ink-2 bg-ink text-paper">
  <div class="wrap grid gap-10 py-16 md:grid-cols-12 md:gap-8 md:py-20">
    <div class="md:col-span-5 lg:col-span-4">
      <Logo tone="paper" class="h-11 w-auto" />
      <p class="mt-5 max-w-[36ch] text-mist">Roof replacement and storm repair for Columbus homeowners since {site.founded}. Free inspections, fixed prices, 25&nbsp;years on our work.</p>
      <a href={site.phone.href} class="mt-6 block text-h3 font-bold no-underline [font-variation-settings:'wdth'_115] hover:text-blueprint-light">{site.phone.display}</a>
      <OpenStatus class="mt-1 text-small text-mist" />
      <address class="mt-4 not-italic text-small text-mist">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</address>
    </div>
    <nav aria-label="Footer" class="md:col-span-3 lg:col-span-2">
      <p class="t-label text-mist">Site</p>
      <ul class="mt-3 flex flex-col gap-1 text-small">
        {nav.map((n) => <li><a href={n.href} class="inline-flex min-h-10 items-center no-underline hover:text-blueprint-light">{n.label}</a></li>)}
        <li><a href="/free-inspection/" class="inline-flex min-h-10 items-center no-underline hover:text-blueprint-light">Free Inspection</a></li>
      </ul>
    </nav>
    <div class="md:col-span-4 lg:col-span-6">
      <p class="t-label text-mist">Where we work</p>
      <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-small text-paper/85 lg:grid-cols-3">
        {serviceArea.map((a) => <li>{a.city}</li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-2">
    <div class="wrap flex flex-col gap-3 py-6 text-small text-mist lg:flex-row lg:items-center lg:justify-between">
      <p>{site.license} · {site.insurance} · {site.certification}</p>
      <p>© {year} {site.name} · <a href="/privacy/" class="hover:text-paper">Privacy</a></p>
    </div>
    <p class="wrap pb-28 text-small text-mist md:pb-8">Concept site · fictional company · designed &amp; built by <strong class="font-semibold text-paper">modd.</strong></p>
  </div>
</footer>
