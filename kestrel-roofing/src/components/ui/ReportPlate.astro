---
// Dark "inspection report" plate laid over a photo.
interface Stat { label: string; value: string }
interface Props { heading: string; stats: Stat[]; compact?: boolean; class?: string }
const { heading, stats, compact = false, class: cls = '' } = Astro.props;
---
<div class={`rounded-sm bg-ink text-paper ${compact ? 'px-3.5 py-2.5' : 'px-4 py-3 md:px-5 md:py-4'} ${cls}`}>
  <p class="t-label border-b border-ink-2 pb-2 text-mist">{heading}</p>
  <dl class={`mt-2 flex ${compact ? 'gap-5' : 'gap-5 md:gap-8'}`}>
    {stats.map((s) => (
      <div>
        <dt class="t-label text-mist">{s.label}</dt>
        <dd class={`font-bold leading-tight [font-variation-settings:'wdth'_115] ${compact ? 'text-[1.125rem]' : 'text-[1.25rem] md:text-[1.5rem]'}`}>{s.value}</dd>
      </div>
    ))}
  </dl>
</div>
