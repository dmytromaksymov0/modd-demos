---
// Responsive photo: AVIF + WebP, lazy by default. Use instead of raw <img> for anything in src/assets.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; widths?: number[]; sizes: string; class?: string; imgClass?: string; position?: string; priority?: boolean }
const { src, alt, widths = [480, 768, 1080, 1440], sizes, class: cls = '', imgClass = '', position, priority = false } = Astro.props;
---
<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  pictureAttributes={{ class: cls }}
  class={`size-full object-cover ${imgClass}`}
  style={position ? `object-position:${position}` : undefined}
/>
