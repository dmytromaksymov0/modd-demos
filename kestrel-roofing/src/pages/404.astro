---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { site, nav } from '../config/site';
import Phone from '@lucide/astro/icons/phone';
---
<BaseLayout title="Page not found | Kestrel Roofing Co." description="This page doesn’t exist. Find roof replacement, storm damage, pricing and free inspection pages from Kestrel Roofing Co. in Columbus." noindex>
  <section class="wrap grid gap-10 py-[var(--spacing-section)] lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="t-label text-blueprint">Inspection #404 · page not found</p>
      <h1 class="t-display mt-4">We checked every slope. This page isn’t&nbsp;here.</h1>
      <p class="t-lead measure mt-5 text-graphite">The link may be old or mistyped. Try one of these — or call us and we’ll point you the right way.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/">Home page</Button>
        <Button href={site.phone.href} variant="secondary"><Phone class="size-5" aria-hidden="true" />{site.phone.display}</Button>
      </div>
    </div>
    <nav aria-label="Popular pages" class="lg:col-span-5">
      <p class="t-label text-graphite">Popular pages</p>
      <ul class="mt-3 divide-y divide-line border-y border-line">
        {[...nav, { label: 'Free Inspection', href: '/free-inspection/' }].map((n) => (
          <li><a href={n.href} class="flex min-h-14 items-center justify-between text-lead font-semibold no-underline hover:text-blueprint">{n.label}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </nav>
  </section>
</BaseLayout>
