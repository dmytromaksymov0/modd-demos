---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/ui/Photo.astro';
import Badge from '../../components/ui/Badge.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { projects } from '../../data/projects';
import { business, breadcrumbs } from '../../lib/schema';
const filters = [{ v: 'all', l: 'All jobs' }, { v: 'replacement', l: 'Replacements' }, { v: 'storm', l: 'Storm claims' }, { v: 'metal', l: 'Metal' }];
const totalSq = projects.reduce((s, p) => s + p.squares, 0);
// First job is wide; so is the last one when it would otherwise sit alone in its row.
const wide = (i: number) => i === 0 || (i === projects.length - 1 && (projects.length - 1) % 2 === 1);
---
<BaseLayout
  title="Roofing Projects in Columbus, Dublin, Hilliard & More | Kestrel"
  description="Recent Kestrel roof replacements and storm claims around Columbus: roof size, pitch, material, time on site and who paid — job by job."
  schema={[business(Astro.site?.href), breadcrumbs(Astro.site?.href, [{ name: 'Projects', path: '/projects/' }])]}
>
  <section class="wrap pt-10 pb-8 lg:pt-14" data-hero>
    <p class="t-label text-graphite">Projects</p>
    <h1 class="t-h1 mt-3 max-w-[18ch]">Recent roofs around Columbus</h1>
    <p class="t-lead measure mt-4 text-graphite">Six jobs from this year, with the numbers that matter: how big, how steep, how long and who paid. Photos are from the job, mid-work — that’s where you see how a crew works.</p>
    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-ink pt-5">
      <div><dt class="t-label text-graphite">Jobs shown</dt><dd class="t-h3 mt-1">{projects.length}</dd></div>
      <div><dt class="t-label text-graphite">Roof installed</dt><dd class="t-h3 mt-1">{totalSq} squares</dd></div>
      <div><dt class="t-label text-graphite">Storm claims</dt><dd class="t-h3 mt-1">{projects.filter((p) => p.tags.includes('storm')).length} of {projects.length}</dd></div>
    </dl>
  </section>

  <section class="wrap pb-[var(--spacing-section)]" aria-label="Project list" data-filter-root>
    <div role="group" aria-label="Filter projects" class="js-filters hidden flex-wrap gap-2 pb-8">
      {filters.map((f, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={f.v} class="min-h-11 rounded-sm border border-line bg-white px-4 font-semibold hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper">{f.l}</button>)}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <ul class="grid gap-x-8 gap-y-14 md:grid-cols-2">
      {projects.map((p, i) => (
        <li class:list={['project flex flex-col gap-4', wide(i) && 'md:col-span-2 lg:grid lg:grid-cols-12 lg:gap-8']} data-tags={p.tags.join(' ')} id={p.slug}>
          <div class:list={['relative overflow-hidden rounded-sm bg-line', wide(i) && 'lg:col-span-7']} style="aspect-ratio:3/2">
            <Photo src={p.img} alt={p.alt} sizes={wide(i) ? '(min-width: 768px) 760px, 100vw' : '(min-width: 768px) 620px, 100vw'} class="absolute inset-0" position={p.pos} />
            <span class="t-label absolute left-3 top-3 rounded-sm bg-ink px-2 py-1 text-paper">{p.kind}</span>
          </div>
          <div class:list={['flex flex-col gap-4', wide(i) && 'lg:col-span-5 lg:justify-center']}>
            <div class="flex items-baseline justify-between gap-4"><h2 class="t-h2">{p.place}, OH</h2><span class="t-label text-graphite">{p.month}</span></div>
            <dl class="grid grid-cols-[6.5rem_1fr] gap-x-4 gap-y-1.5 border-y border-line py-4 text-small">
              <dt class="t-label pt-0.5 text-graphite">Roof</dt><dd class="font-medium">{p.squares} squares · {p.pitch}</dd>
              <dt class="t-label pt-0.5 text-graphite">Material</dt><dd class="font-medium">{p.material}</dd>
              <dt class="t-label pt-0.5 text-graphite">Time</dt><dd class="font-medium">{p.days} {p.days === 1 ? 'day' : 'days'}</dd>
              <dt class="t-label pt-0.5 text-graphite">Paid by</dt><dd class="font-medium">{p.paidBy}</dd>
            </dl>
            <p class="t-small"><b>What we found.</b> <span class="text-graphite">{p.found}</span></p>
            <p class="t-small"><b>What we did.</b> <span class="text-graphite">{p.did}</span></p>
            {p.review && (
              <figure class="rounded-sm bg-white p-4">
                <blockquote>“{p.review.text}”</blockquote>
                <figcaption class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-small text-graphite">— {p.review.who}<Badge variant="note" tone="blueprint">Sample review</Badge></figcaption>
              </figure>
            )}
          </div>
        </li>
      ))}
    </ul>
    <p class="t-small mt-12 text-graphite">Sample reviews — replaced with real Google reviews at launch. Before/after comparisons appear here once we have matching photos of the same house.</p>
  </section>
  <FinalCta />
</BaseLayout>
<style is:global>
  html.js [data-filter-root] .js-filters { display: flex; }
  .project[hidden] { display: none !important; }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-filter-root]');
  if (root) {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('.project')];
    const status = root.querySelector<HTMLElement>('[data-filter-status]')!;
    btns.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      items.forEach((it) => { const show = f === 'all' || it.dataset.tags!.split(' ').includes(f); it.hidden = !show; if (show) n++; });
      status.textContent = `Showing ${n} ${n === 1 ? 'project' : 'projects'}`;
    }));
  }
</script>
