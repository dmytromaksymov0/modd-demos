---
import type { ImageMetadata } from 'astro';
import Photo from '../ui/Photo.astro';
import Badge from '../ui/Badge.astro';
interface Props { photo: ImageMetadata; name: string; role: string; school: string; why: string; languages?: string; position?: string; class?: string }
const { photo, name, role, school, why, languages, position = '50% 50%', class: cls = '' } = Astro.props;
---
<article class={`flex flex-col gap-4 ${cls}`}>
  <div class="aspect-[4/5] overflow-hidden rounded-md bg-spring-50">
    <Photo src={photo} alt={`${name}, ${role}`} widths={[360, 540, 720]} sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 90vw" position={position} quality={48} />
  </div>
  <div class="flex flex-col gap-1.5">
    <h3 class="t-h3">{name}</h3>
    <p class="text-small text-stone">{role} · {school}</p>
    {languages && <Badge tone="spring" class="self-start">{languages}</Badge>}
    <p class="mt-1 text-body">“{why}”</p>
  </div>
</article>
