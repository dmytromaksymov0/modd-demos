---
// Insurance check answer in dollars (signature moment B) — static state for the styleguide.
interface Props { carrier?: string; plan?: string; amount?: string; detail?: string; class?: string }
const {
  carrier = 'Delta Dental', plan = 'PPO', amount = '$0',
  detail = 'typical cost of your cleaning, exam and X-rays — preventive care is usually covered at 100%',
  class: cls = '',
} = Astro.props;
---
<section class={`rounded-md border border-line bg-white p-5 sm:p-6 ${cls}`} aria-labelledby="ins-h">
  <h3 id="ins-h" class="font-display text-[1.375rem] font-[750] leading-tight tracking-[-0.02em]">Am I covered?</h3>
  <p class="mt-3 flex items-center gap-2 font-display font-[650] text-spring">
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
    In-network with {carrier} {plan}
  </p>
  <div class="mt-3 grid grid-cols-[auto_1fr] items-end gap-4">
    <p class="t-figure text-ink">{amount}</p>
    <p class="text-small">{detail}</p>
  </div>
  <p class="mt-4 border-t border-line pt-3 text-label font-normal text-stone">Estimate only — we confirm your exact benefits before your visit.</p>
</section>
