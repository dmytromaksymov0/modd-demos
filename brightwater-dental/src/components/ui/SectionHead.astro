---
// Section heading: short label with a rope segment, then the heading and an optional lead.
import Rope from './Rope.astro';
interface Props { label?: string; title: string; lead?: string; id?: string; as?: 'h1' | 'h2'; rope?: boolean; class?: string }
const { label, title, lead, id, as: Tag = 'h2', rope = false, class: cls = '' } = Astro.props;
---
<div class={`flex flex-col gap-4 ${cls}`}>
  {label && (
    <p class="t-label flex items-center gap-3 text-stone">
      {rope && <Rope variant="segment" />}{label}
    </p>
  )}
  <Tag id={id} class={Tag === 'h1' ? 't-h1' : 't-h2'}>{title}</Tag>
  {lead && <p class="t-lead measure text-stone">{lead}</p>}
</div>
