---
// Real photos only, optimised by astro:assets (AVIF/WebP, srcset, lazy by default).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; widths?: number[]; sizes?: string; priority?: boolean; class?: string; position?: string; quality?: number }
const { src, alt, widths = [480, 768, 1080, 1440, 1920], sizes = '100vw', priority = false, class: cls = '', position = '50% 50%', quality = 60 } = Astro.props;
---
<Picture src={src} alt={alt} widths={widths.filter((w) => w <= src.width)} sizes={sizes} formats={['avif', 'webp']}
  quality={quality} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding={priority ? 'sync' : 'async'}
  class={`block h-full w-full object-cover ${cls}`} style={`object-position:${position}`} />
