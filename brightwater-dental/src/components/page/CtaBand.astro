---
// Closing call to action on inner pages: one booking link (prefilled), phone, hours.
import Button from '../ui/Button.astro';
import OpenStatus from '../layout/OpenStatus.astro';
import { site, hours } from '../../config/site';
interface Props { title?: string; text?: string; href?: string; label?: string }
const { title = 'Ready when your calendar is.', text = 'Evenings until 7 pm Monday to Thursday, Saturdays 8–2. Book online in about a minute.', href = '/book/', label = 'Book online' } = Astro.props;
---
<section class="bg-spring-25 py-(--spacing-section)" aria-labelledby="cta-h">
  <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-end" data-booking>
    <div class="flex flex-col gap-4 lg:col-span-7">
      <h2 id="cta-h" class="t-h1 max-w-[16ch]">{title}</h2>
      <p class="t-lead measure text-stone">{text}</p>
    </div>
    <div class="flex flex-col gap-3 lg:col-span-5 lg:items-end">
      <Button href={href} size="lg">{label}</Button>
      <a href={site.phone.href} class="inline-flex min-h-11 items-center font-display font-[650] no-underline tabular-nums hover:underline">or call {site.phone.display}</a>
      <p class="text-small text-stone"><OpenStatus /> · {hours.summary}</p>
    </div>
  </div>
</section>
