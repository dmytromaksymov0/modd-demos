---
import Logo from '../brand/Logo.astro';
import { site, nav, hours } from '../../config/site';
import { fmt } from '../../lib/hours';
---
<footer class="on-dark mt-auto bg-ink text-white">
  <div class="wrap grid gap-10 py-14 md:grid-cols-12">
    <div class="flex flex-col gap-4 md:col-span-4">
      <Logo tone="light" class="h-12 w-auto self-start" />
      <p class="text-small text-mist">Family dentistry in Mueller, Austin — open evenings and every Saturday.</p>
      <p class="font-display font-[650]">Hablamos español</p>
    </div>
    <div class="flex flex-col gap-2 text-small md:col-span-3">
      <h2 class="t-label text-mist">Visit</h2>
      <address class="not-italic leading-relaxed">{site.address.street}<br />{site.address.city}, {site.address.region} {site.address.zip}</address>
      <a href={site.phone.href} class="inline-flex min-h-11 items-center self-start font-display text-[1.125rem] font-[700] tabular-nums">{site.phone.display}</a>
    </div>
    <div class="flex flex-col gap-2 text-small md:col-span-3">
      <h2 class="t-label text-mist">Hours</h2>
      <dl class="grid grid-cols-[3rem_1fr] gap-x-3 gap-y-1">
        {hours.days.map((d) => (<><dt class="font-display font-[650]">{d.short}</dt><dd class="tabular-nums">{fmt(d.open)} – {fmt(d.close)}</dd></>))}
        <dt class="font-display font-[650]">Sun</dt><dd class="text-mist">Closed</dd>
      </dl>
    </div>
    <nav aria-label="Footer" class="flex flex-col text-small md:col-span-2">
      <h2 class="t-label text-mist">Pages</h2>
      {nav.map((n) => <a href={n.href} class="inline-flex min-h-11 items-center no-underline hover:underline">{n.label}</a>)}
      <a href="/book/" class="inline-flex min-h-11 items-center no-underline hover:underline">Book online</a>
    </nav>
  </div>
  <div class="wrap pb-8">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-ink-2 pt-4"><p class="text-label font-normal text-mist">Concept site · fictional company · designed &amp; built by modd.</p><a href="/privacy/" class="inline-flex min-h-11 min-w-11 items-center justify-center text-label font-normal text-mist underline underline-offset-4 hover:text-white">Privacy</a></div>
  </div>
</footer>
