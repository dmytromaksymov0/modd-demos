---
// Home hero. Photo is 3:2 and never cropped at the sides, so dad, Leo and Mia stay in frame;
// the crew card overlaps only the lower-left of the photo (dad's shoulder), below every face.
import Button from '../ui/Button.astro';
import Photo from '../ui/Photo.astro';
import WeekLanes from '../patterns/WeekLanes.astro';
import CrewCard from '../patterns/CrewCard.astro';
import hero from '../../assets/photos/hero-4-dad-kids-brushing.jpg';
---
<section class="wrap grid gap-8 pb-14 pt-6 lg:grid-cols-12 lg:gap-x-10 lg:pb-20 lg:pt-12" data-hero aria-labelledby="hero-h">
  <div class="flex flex-col gap-5 lg:col-span-6 lg:pt-4">
    <p class="t-label text-stone">Three dentists, one family calendar · Mueller, Austin</p>
    <h1 id="hero-h" class="hero-title font-display font-[800]">Dentistry on family time. Even <span class="hl-sun">Saturdays.</span></h1>
    <p class="t-lead measure text-stone">Open <b class="text-ink">until 7&nbsp;pm</b> Monday to Thursday and <b class="text-ink">every Saturday morning</b>. Book the whole crew in one go — chairs side by side, everyone done in an hour.</p>
    <div class="grid grid-cols-1 gap-3 sm:flex sm:flex-wrap">
      <Button href="/book/" size="lg">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>Book online
      </Button>
      <Button href="#insurance" variant="secondary" size="lg">Check my insurance</Button>
    </div>
    <WeekLanes variant="compact" class="lg:hidden" />
    <WeekLanes class="mt-3 hidden max-w-xl lg:grid" />
  </div>
  <div class="relative lg:col-span-6">
    <div class="aspect-[3/2] overflow-hidden rounded-md lg:rounded-lg">
      <Photo src={hero} alt="A dad and his two kids brushing their teeth together at the bathroom sink" priority quality={48}
        widths={[480, 720, 960, 1280, 1600]} sizes="(min-width: 86rem) 41rem, (min-width: 64rem) 48vw, 100vw" position="50% 30%" />
    </div>
    <CrewCard floating headingId="hero-crew-h" date="Sat, Nov 7" class="relative mt-4 lg:-mt-28 lg:ml-6 lg:max-w-[23rem]" />
  </div>
</section>
<style>
  .hero-title { font-size: clamp(2.75rem, 1.7rem + 3.2vw, 4.5rem); line-height: 0.98; letter-spacing: -0.035em; }
</style>
