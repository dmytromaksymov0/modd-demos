---
import ServiceLayout from '../../../components/page/ServiceLayout.astro';
import { services } from '../../../data/services';
const s = services.find((x) => x.slug === 'cleanings-exams')!;
const rows = [
  ['Where it cleans', 'Above the gum line', 'Below the gum line, inside the pockets'],
  ['When you need it', 'Healthy gums, pockets 1–3 mm', 'Gum disease, pockets 4 mm or deeper'],
  ['How long', 'About 30 minutes', 'Two visits of about an hour, one side of the mouth each'],
  ['Numbing', 'Not usually', 'Yes, local numbing'],
  ['Typical PPO coverage', '100%', 'About 80% after the deductible'],
];
---
<ServiceLayout s={s} title="Dental cleanings & exams in Austin | Brightwater Family Dental" description="Cleanings and exams for the whole family in Mueller, Austin. About an hour, usually $0 with PPO insurance, evenings and Saturdays.">
  <section class="wrap py-(--spacing-section)" aria-labelledby="deep-h">
    <div class="flex flex-col gap-8">
      <div class="flex max-w-3xl flex-col gap-4">
        <p class="t-label text-stone">Regular vs deep cleaning</p>
        <h2 id="deep-h" class="t-h2">If we say “deep cleaning”, here’s exactly what that means.</h2>
        <p class="text-stone">We measure every gum pocket and read the numbers out loud. You decide when — never in the middle of a visit you didn’t plan for.</p>
      </div>
      <div class="overflow-x-auto rounded-md border border-line bg-white">
        <table class="w-full text-left text-small">
          <thead class="bg-spring-25 font-display"><tr><th scope="col" class="w-1/4 p-4 font-[650] text-stone"><span class="sr-only">Compare</span></th><th scope="col" class="p-3 sm:p-4 font-[750]">Regular cleaning</th><th scope="col" class="p-3 sm:p-4 font-[750]">Deep cleaning</th></tr></thead>
          <tbody class="divide-y divide-line">{rows.map(([k, a, b]) => <tr><th scope="row" class="p-3 sm:p-4 font-display font-[650]">{k}</th><td class="p-3 sm:p-4">{a}</td><td class="p-3 sm:p-4">{b}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>
</ServiceLayout>
