---
// «Хочу так само»: a work in the tip, who made it, what and how long, and a button that opens the booking
// with the service and the master already chosen (?posluga=&maister=&kolir=).
import TipPhoto from '../booking/TipPhoto.astro';
import { masters } from '../../data/masters';
import { services, duration, uah, topPrice } from '../../data/services';
import { shades } from '../../data/shades';
import type { Work } from '../../data/works';
interface Props { work: Work; ratio?: string; base?: string }
const { work: w, ratio = '4 / 5', base = '/zapys/' } = Astro.props;
const m = masters.find((x) => x.id === w.master)!;
const s = services.find((x) => x.id === w.service)!;
const shade = shades.find((x) => x.id === w.shade);
const href = `${base}?posluga=${s.id}&maister=${m.id}${shade ? `&kolir=${shade.id}` : ''}#zapys`;
---
<article class="work-card group flex min-w-0 flex-col gap-2.5" data-group={w.group} data-shade={w.shade ?? ""}>
  <TipPhoto src={w.photo} alt={w.alt} ratio={ratio} sizes="(min-width: 64rem) 22vw, 44vw" />
  <div class="grid gap-1">
    <h3 class="font-display text-[1.0625rem] font-medium leading-tight">{w.title}</h3>
    <p class="text-caption text-graphite">{m.name.split(' ')[0]}{m.top ? ' · топ' : ''} · {duration(s.minutes)} · від {uah(m.top ? topPrice(s.price) : s.price)}</p>
  </div>
  <a href={href} data-prefill class="inline-flex min-h-11 w-fit items-center gap-2 rounded-full border-[1.5px] border-ink px-4 text-small font-semibold no-underline transition-colors hover:bg-ink hover:text-white">
    {shade && <span class="tip-sm block h-5 w-3.5 shadow-[inset_0_0_0_1px_rgb(34_27_30/0.14)]" style={`background:var(${shade.token})`} aria-hidden="true"></span>}
    Хочу так само<span class="sr-only">: {w.title}, майстриня {m.name}</span>
  </a>
</article>
