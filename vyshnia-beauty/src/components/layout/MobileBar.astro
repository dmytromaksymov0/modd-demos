---
// Mobile bottom bar on pages without a booking summary: «Записатися» + Telegram. Hidden from lg up.
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site';
interface Props { bookHref?: string; fixed?: boolean }
const { bookHref = '/zapys/', fixed = true } = Astro.props;
---
<div class={`mobile-bar ${fixed ? 'fixed inset-x-2 bottom-2 z-40 lg:hidden' : 'relative'} flex items-center gap-2 rounded-[18px] bg-white p-2 shadow-(--shadow-float)`} data-check="mobilebar">
  <Button href={bookHref} class="min-w-0 flex-1" iconAfter="arrow-right">Записатися</Button>
  <a href={site.telegram} class="inline-flex min-h-12 min-w-12 shrink-0 items-center justify-center gap-2 rounded-full border-[1.5px] border-line-strong px-3.5 text-small font-semibold no-underline"><Icon name="send" size={18} /><span class="max-[359px]:sr-only">Telegram</span></a>
</div>
