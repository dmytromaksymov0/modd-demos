---
// Step 1 option: a service group as a tip. A real radio inside a label — arrows, Space and screen readers work
// without JS. The selected tip gets a cherry ring that follows the arch (outline follows border-radius).
import TipPhoto from './TipPhoto.astro';
import { duration, uah } from '../../data/services';
interface Props { name?: string; value: string; title: string; photo: string; alt: string; minutes: number; from: number; checked?: boolean; ratio?: string; priority?: boolean; position?: string }
const { name = 'posluga', value, title, photo, alt, minutes, from, checked = false, ratio = '3 / 4', priority = false, position } = Astro.props;
---
<label class="service-tip group relative flex min-w-0 cursor-pointer flex-col gap-2.5">
  <input class="sr-only" type="radio" name={name} value={value} checked={checked} />
  <span class="relative block rounded-[999px_999px_18px_18px] outline-offset-4 transition-[outline-color] duration-(--duration-fast) group-has-checked:outline-3 group-has-checked:outline-cherry group-has-focus-visible:outline-3 group-has-focus-visible:outline-ink">
    <TipPhoto src={photo} alt={alt} ratio={ratio} priority={priority} position={position} sizes="(min-width: 64rem) 17vw, (min-width: 40rem) 30vw, 40vw" />
    <span class="absolute left-1/2 top-3 hidden -translate-x-1/2 rounded-full bg-cherry px-2.5 py-1 text-micro font-semibold text-white group-has-checked:block">Обрано</span>
  </span>
  <span class="font-display text-[1.0625rem] leading-tight font-medium tracking-[-0.01em] sm:text-h3">{title}</span>
  <span class="flex flex-wrap items-baseline justify-between gap-x-2 text-caption text-graphite"><span>{duration(minutes)}</span><strong class="num font-semibold text-ink">від {uah(from)}</strong></span>
</label>
