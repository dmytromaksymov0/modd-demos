---
// «Ваш запис» — always next to the steps (desktop panel) or pinned to the bottom (mobile bar).
// The guarantee row turns the brief's «21 день» into a date: visit + 21 days, coated services only.
// `live`: the booking form — CTAs become Next / Back buttons and every value gets a [data-sum-*] hook for booking-ui.ts.
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { uah } from '../../data/services';
interface Row { label: string; value: string; empty?: boolean }
interface Props { variant?: 'panel' | 'bar' | 'both'; step?: number; rows: Row[]; total: number; totalNote?: string; guarantee?: string; cta: string; ctaShort?: string; ctaHref?: string; class?: string; live?: boolean }
const { variant = 'both', step = 1, rows, total, totalNote = 'Разом', guarantee, cta, ctaShort = 'Далі', ctaHref = '#', class: cls = '', live = false } = Astro.props;
const panel = variant !== 'bar', bar = variant !== 'panel';
const keys: Record<string, string> = { 'Послуга': 'posluga', 'Колір': 'kolir', 'Майстер': 'maister', 'Коли': 'koly' };
---
{panel && (
  <aside class={`summary-panel flex flex-col gap-3 rounded-card bg-white p-5 pt-4 shadow-(--shadow-hair) ${variant === 'both' ? 'hidden lg:flex' : ''} ${cls}`} aria-label="Ваш запис" data-check="summary">
    <p class="flex justify-between text-caption text-graphite"><span class="font-semibold text-ink">Ваш запис</span><span>крок <span data-sum-step>{step}</span> з 4</span></p>
    <dl class="grid gap-2">
      {rows.map((r) => (
        <div class="grid grid-cols-[5.25rem_minmax(0,1fr)] gap-2 border-b border-line pb-2 text-small">
          <dt class="text-graphite">{r.label}</dt><dd class={r.empty ? 'text-graphite' : 'font-semibold text-ink'} data-sum={live ? keys[r.label] : undefined}>{r.value}</dd>
        </div>
      ))}
    </dl>
    <slot name="extra" />
    <p class="flex items-baseline justify-between gap-3"><span class="text-small text-graphite" data-sum-note>{totalNote}</span><strong class="t-price" data-sum-total>{uah(total)}</strong></p>
    {guarantee && (
      <p class="flex items-center gap-3 rounded-field bg-porcelain px-3 py-2.5 text-caption leading-snug" data-sum-guar>
        <span class="tip-sm block h-6 w-4 shrink-0 bg-cherry" aria-hidden="true"></span>
        <span>Гарантія на покриття — <strong class="font-semibold whitespace-nowrap" data-sum-guar-date>{live ? guarantee : `до ${guarantee}`}</strong></span>
      </p>
    )}
    {live ? (
      <div class="grid gap-2">
        <Button iconAfter="arrow-right" class="w-full" data-check="cta" data-next><span data-cta>{cta}</span></Button>
        <button type="button" class="hidden min-h-11 items-center justify-center gap-1.5 rounded-full text-small font-semibold text-graphite hover:text-ink" data-back><Icon name="arrow-left" size={16} />Назад</button>
      </div>
    ) : (
      <Button href={ctaHref} iconAfter="arrow-right" class="w-full" data-check="cta">{cta}</Button>
    )}
  </aside>
)}
{bar && (
  <div class={`summary-bar fixed inset-x-2 bottom-2 z-40 flex items-center gap-2 rounded-[18px] bg-white py-2.5 pr-2.5 pl-4 shadow-(--shadow-float) ${variant === 'both' ? 'lg:hidden' : ''} ${live ? 'when-js-flex' : ''}`} aria-label="Ваш запис" data-check="bar">
    {live && <button type="button" class="hidden size-11 shrink-0 place-items-center rounded-full border-[1.5px] border-line-strong" aria-label="Назад" data-back><Icon name="arrow-left" size={18} /></button>}
    <p class="grid min-w-0 gap-0.5 leading-tight"><strong class="t-price text-[1.375rem]" data-sum-total>{uah(total)}</strong><span class="truncate text-caption text-graphite" data-sum-bar-note>{guarantee ? (live ? 'гарантія 21 день' : `гарантія до ${guarantee}`) : totalNote}</span></p>
    {live
      ? <Button iconAfter="arrow-right" class="ml-auto shrink-0" data-next aria-label={cta}><span data-cta-short>{ctaShort}</span></Button>
      : <Button href={ctaHref} iconAfter="arrow-right" class="ml-auto shrink-0" aria-label={cta}>{ctaShort}</Button>}
  </div>
)}
