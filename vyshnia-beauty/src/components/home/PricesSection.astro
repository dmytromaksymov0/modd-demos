---
// Prices at a glance: every service with both categories side by side (no hidden toggle), each row books in one click.
import SectionHead from './SectionHead.astro';
import { groups, topPrice, uah, duration } from '../../data/services';
import { servicesIn as byGroup } from '../../lib/booking';
const titles: Record<string, string> = { manicure: 'Манікюр', pedicure: 'Педикюр', brows: 'Брови', lashes: 'Вії' };
---
<section class="wrap pt-(--spacing-section)" aria-labelledby="prices-title" id="tsiny">
  <SectionHead id="prices-title" title="Ціни без сюрпризів" lead="Зняття старого покриття входить у вартість. Ціну з урахуванням майстрині видно в записі ще до підтвердження." href="/poslugy/" linkText="Усі послуги та ціни" />
  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {groups.map((g) => (
      <div class="rounded-card bg-white p-5 sm:p-6">
        <h3 class="font-display text-h3 font-medium">{titles[g.id]}</h3>
        <table class="mt-3 w-full text-small">
          <caption class="sr-only">{titles[g.id]}: тривалість і ціна у майстрині та топ-майстрині</caption>
          <thead><tr class="text-caption text-graphite"><th scope="col" class="py-2 text-left font-normal">Послуга</th><th scope="col" class="py-2 text-right font-normal">майстриня</th><th scope="col" class="py-2 pl-3 text-right font-normal">топ</th></tr></thead>
          <tbody>
            {byGroup(g.id).map((s) => (
              <tr class="border-t border-line">
                <th scope="row" class="py-1 pr-2 text-left font-normal"><a href={`/?posluga=${s.id}#zapys`} data-prefill class="flex min-h-11 flex-col justify-center font-semibold no-underline hover:underline">{s.short}<span class="text-caption font-normal text-graphite">{duration(s.minutes)}</span></a></th>
                <td class="py-2.5 text-right font-semibold num">{uah(s.price)}</td>
                <td class="py-2.5 pl-3 text-right text-graphite num">{uah(topPrice(s.price))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </div>
</section>
