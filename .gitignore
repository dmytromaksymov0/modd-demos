# dependencies
node_modules/

# build output and caches
dist/
.astro/
.wrangler/

# secrets (examples like .dev.vars.example stay tracked)
.dev.vars
.env
.env.*
!.env.example

# OS / logs
.DS_Store
*.log
npm-debug.log*

# QA artifacts (regenerated by each site's scripts; summaries live in docs/)
/*/screenshots/
/*/reports/

# portfolio: raw screenshots are regenerated by `npm run capture`; review/ is a one-off before/after set
portfolio.zip
*.tgz
portfolio/raw/
portfolio/review/
portfolio/templates/.out/
