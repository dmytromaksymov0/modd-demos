---
// Photo with an honest caption (describes only what is in the frame — see CREDITS.md).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
// fill: the image covers the figure absolutely, so the figure's box (not the photo's intrinsic height) sets the size.
interface Props { src: ImageMetadata; alt: string; caption?: string; widths?: number[]; sizes?: string; position?: string; class?: string; imgClass?: string; loading?: 'lazy' | 'eager'; fetchpriority?: 'high' | 'auto'; fill?: boolean }
const { src, alt, caption, widths = [480, 800, 1200, 1600], sizes = '(min-width: 64rem) 40vw, 100vw', position = '50% 50%', class: cls = '', imgClass = '', loading = 'lazy', fetchpriority, fill = true } = Astro.props;
---
<figure class={`relative overflow-hidden ${cls}`}>
  <Picture src={src} alt={alt} widths={widths} sizes={sizes} formats={['avif', 'webp']} quality={60} loading={loading} fetchpriority={fetchpriority}
    class={`${fill ? 'absolute inset-0' : ''} size-full object-cover ${imgClass}`} style={`object-position:${position}`} />
  {caption && <figcaption class="t-caption absolute bottom-0 left-0 max-w-[90%] bg-surface px-4 pt-2 text-fg-mute">{caption}</figcaption>}
</figure>
