---
// A doctor with a photo (only people from consistent Pexels series). Doctors without a photo use DoctorRow.astro.
import Figure from './Figure.astro';
import { shiftsOf, type Doctor } from '../../data/doctors';
import type { ImageMetadata } from 'astro';
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
interface Props { d: Doctor; compact?: boolean; headingLevel?: 'h2' | 'h3' }
const { d, compact = false, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const pos: Record<string, string> = { 'doctor-male-pomeranian': '50% 30%', 'doctor-female-pomeranian': '50% 38%', 'doctor-blue-shepherd': '45% 30%' };
---
<article class="doc grid content-start gap-3" data-doc={d.id}>
  <Figure src={photos[`../../assets/photos/${d.photo}.jpg`].default} alt={d.photoAlt!} position={pos[d.photo!]} widths={[360, 560, 800]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" class={`${compact ? 'aspect-[4/3]' : 'aspect-[4/5]'} rounded-sm`} />
  <H class="t-h3 font-serif font-medium">{d.name}</H>
  <p class="-mt-2 text-fg-mute">{d.role} · {d.years} років досвіду</p>
  <p class="text-[0.9375rem]">{d.plain}</p>
  {!compact && <p class="text-[0.9375rem] text-fg-mute">{shiftsOf(d.id)}</p>}
</article>
