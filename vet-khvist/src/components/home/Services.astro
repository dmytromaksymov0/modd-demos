---
// Four directions as an editorial index (rows with hairlines, not identical shadow cards) + «Ціна до каси»:
// one «все включено» sum per animal and weight, with what is and is not included (Wise, phase 0).
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
import Badge from '../ui/Badge.astro';
import Figure from '../patterns/Figure.astro';
import { directions, allIn, weights, allInIncludes, allInExcludes } from '../../data/services';
import type { ImageMetadata } from 'astro';
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const P = (n: string) => photos[`../../assets/photos/${n}.jpg`].default;
const uah = (n: number) => `${n.toLocaleString('uk-UA').replace(/\s/g, ' ')} грн`;
---
<section id="poslugy" class="is-day-surface bg-surface py-[var(--spacing-section)] text-fg" aria-labelledby="t-services">
  <div class="wrap grid gap-12">
    <SectionHead kicker="Послуги" title="З чим приходять планово" id="t-services">Чотири напрями, 9 лікарів. Ціна «від» — за звичайний випадок, точну назве лікар після огляду.</SectionHead>
    <ul class="grid">
      {directions.map((d) => (
        <li class="row grid gap-5 border-t border-ink py-6 sm:grid-cols-[11rem_minmax(0,1fr)] md:grid-cols-[14rem_minmax(0,1fr)_auto] md:items-center md:gap-8">
          <Figure src={P(d.photo)} alt={d.photoAlt} position={d.position} widths={[320, 480]} sizes="(min-width: 48rem) 14rem, 11rem" class="hidden aspect-[4/3] rounded-sm sm:block" />
          <div class="grid gap-2">
            <h3 class="t-h2"><a href={d.href} class="no-underline hover:underline">{d.title}</a></h3>
            <p class="text-fg-mute">{d.reasons.join(' · ')}</p>
          </div>
          <a href={d.href} class="price flex min-h-11 items-baseline gap-2 no-underline sm:col-start-2 md:col-start-auto md:justify-self-end" aria-label={`${d.title}: від ${uah(d.from)}, детальніше`}>
            <span class="text-[0.9375rem] text-fg-mute">від</span><span class="num text-[1.5rem] font-bold">{uah(d.from)}</span>
            <span class="text-[0.875rem] text-fg-mute">{d.fromNote}</span><Icon name="arrow-right" class="size-5 self-center" />
          </a>
        </li>))}
    </ul>

    <div id="tsina-do-kasy" class="grid gap-6 rounded-sm bg-white p-4 text-ink sm:p-6 md:p-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12">
      <div class="grid content-start gap-4">
        <Badge tone="lamp" class="justify-self-start">все включено</Badge>
        <h3 class="t-h2">Ціна до каси — одна сума, без «без урахування наркозу»</h3>
        <p class="font-semibold">У ціну входить:</p>
        <ul class="grid gap-1.5">{allInIncludes.map((x) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 size-5 shrink-0" />{x}</li>)}</ul>
        <p class="text-[0.9375rem] text-stone">{allInExcludes}</p>
      </div>
      <div class="min-w-0">
        <table class="prices w-full text-left">
          <caption class="sr-only">Ціни «все включено» для котів і собак за вагою</caption>
          <thead class="text-[0.875rem] text-stone">
            <tr class="max-md:hidden"><td></td><td></td><th scope="colgroup" colspan="4" class="border-b border-line pb-1.5 text-center font-normal">Собака, вага</th></tr>
            <tr><th scope="col" class="pb-3 font-normal">Послуга</th><th scope="col" class="pb-3 text-right font-normal">Кіт</th>
              {weights.map((w, i) => <th scope="col" class={`pb-3 text-right font-normal ${i ? 'max-md:hidden' : ''}`}><span class="md:hidden">Собака </span>{w}</th>)}</tr>
          </thead>
          <tbody>
            {allIn.map((r) => (
              <tr class="border-t border-line align-top">
                <th scope="row" class="py-3 pr-3 font-semibold">{r.what}{r.note && <span class="block text-[0.875rem] font-normal text-stone">{r.note}</span>}</th>
                <td class="num py-3 text-right">{r.cat ? uah(r.cat) : '—'}</td>
                {r.dog!.map((p, i) => <td class={`num py-3 text-right ${i ? 'max-md:hidden' : ''}`}>{uah(p)}</td>)}
              </tr>))}
          </tbody>
        </table>
        <a href="/tsiny/" class="mt-4 inline-flex min-h-11 items-center gap-1.5 font-semibold md:hidden">Ціни для собак усіх ваг<Icon name="arrow-right" class="size-4" /></a>
      </div>
    </div>
  </div>
</section>
<style>
  .row:last-child { border-bottom: 1px solid var(--color-ink); }
  .price:hover .num { text-decoration: underline; }
  .prices td { white-space: nowrap; padding-left: 0.75rem; }
  .prices thead th { padding-left: 0.75rem; }
  .prices thead th:first-child { padding-left: 0; }
  @media (min-width: 48rem) { .prices thead th { white-space: nowrap; } }
</style>
