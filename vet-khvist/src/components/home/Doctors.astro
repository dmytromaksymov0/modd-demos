---
// Three doctors with photos (consistent Pexels series only) + «Чергові цього тижня» + «Ще 6 лікарів».
import Icon from '../ui/Icon.astro';
import SectionHead from '../ui/SectionHead.astro';
import Figure from '../patterns/Figure.astro';
import { doctors, nightThisWeek } from '../../data/doctors';
import type { ImageMetadata } from 'astro';
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photos/*.jpg', { eager: true });
const P = (n: string) => photos[`../../assets/photos/${n}.jpg`].default;
const withPhoto = doctors.filter((d) => d.photo).slice(0, 3);
const night = nightThisWeek().map((id) => doctors.find((d) => d.id === id)!);
const rest = doctors.length - withPhoto.length;
const pos: Record<string, string> = { 'doctor-male-pomeranian': '50% 30%', 'doctor-female-pomeranian': '50% 38%', 'doctor-blue-shepherd': '45% 30%' };
---
<section id="likari" class="is-day-surface bg-surface py-[var(--spacing-section)] text-fg" aria-labelledby="t-doctors">
  <div class="wrap grid gap-10">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHead kicker="Лікарі" title="Хто вас прийме" id="t-doctors">9 лікарів: терапевти, хірурги, анестезіологи, вузькі спеціалісти. Вночі — черговий лікар і анестезіолог на місці.</SectionHead>
      <a href="/likari/" class="inline-flex min-h-11 items-center gap-2 font-semibold">Ще {rest} лікарів<Icon name="arrow-right" class="size-5" /></a>
    </div>
    <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {withPhoto.map((d) => (
        <li class="grid content-start gap-3">
          <Figure src={P(d.photo!)} alt={d.photoAlt!} position={pos[d.photo!]} widths={[360, 560, 800]} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" class="aspect-[4/5] rounded-sm" />
          <p class="t-h3 font-serif font-medium">{d.name}</p>
          <p class="-mt-2 text-fg-mute">{d.role} · {d.years} років досвіду</p>
          <p class="text-[0.9375rem]">{d.plain}</p>
        </li>))}
    </ul>
    <div class="duty is-night-surface grid gap-3 rounded-sm bg-surface p-6 text-fg md:grid-cols-[auto_minmax(0,1fr)] md:items-center md:gap-8">
      <p class="t-kicker flex items-center gap-2 text-lamp"><Icon name="moon" class="size-4" />Чергові цього тижня вночі</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2">{night.map((d) => <li><span class="font-semibold">{d.name}</span> <span class="text-fg-mute">· {d.role.toLowerCase()}</span></li>)}</ul>
    </div>
  </div>
</section>
