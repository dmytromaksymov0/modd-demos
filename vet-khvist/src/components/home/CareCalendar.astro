---
// «Календар турботи» teaser (moment 4.3). No JS: the typical plan in words. JS: real dates from src/lib/care.ts
// for the chosen animal and age, plus the bot reply it would send (marked «приклад повідомлення»).
import Icon from '../ui/Icon.astro';
import Chip from '../ui/Chip.astro';
import Button from '../ui/Button.astro';
import SectionHead from '../ui/SectionHead.astro';
import BotMessage from '../patterns/BotMessage.astro';
import { club } from '../../config/site';
---
<section id="klub" class="is-day-surface bg-surface py-[var(--spacing-section)] text-fg" aria-labelledby="t-club">
  <div class="wrap grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] lg:gap-16">
    <div class="grid min-w-0 grid-cols-1 content-start gap-6">
      <SectionHead kicker="Клуб турботи · безкоштовно" title="Нагадаємо про щеплення раніше, ніж ви згадаєте" id="t-club">
        Оберіть, хто у вас, — покажемо найближчі дати. Бот у Telegram напише за кілька днів і запропонує час. Учасникам клубу — знижка {club.discount} % на щеплення, огляди й чекапи.
      </SectionHead>
      <form class="grid min-w-0 grid-cols-1 gap-4" data-care data-lazy onsubmit="return false" aria-label="Календар турботи">
        <div role="radiogroup" aria-labelledby="c-sp" class="grid gap-2"><p id="c-sp" class="font-semibold">Хто</p><div class="flex flex-wrap gap-2"><Chip type="radio" name="c-species" value="cat" checked>Кіт</Chip><Chip type="radio" name="c-species" value="dog">Собака</Chip></div></div>
        <div role="radiogroup" aria-labelledby="c-age" class="grid gap-2"><p id="c-age" class="font-semibold">Вік</p><div class="flex flex-wrap gap-2"><Chip type="radio" name="c-age" value="baby">до 4 міс</Chip><Chip type="radio" name="c-age" value="young">до року</Chip><Chip type="radio" name="c-age" value="adult" checked>дорослий</Chip><Chip type="radio" name="c-age" value="senior">8+ років</Chip></div></div>
        <label class="grid max-w-xs gap-1.5"><span class="font-semibold">Останнє щеплення <span class="font-normal text-fg-mute">— якщо пам’ятаєте</span></span>
          <input type="text" name="c-last" inputmode="numeric" autocomplete="off" placeholder="мм.рррр, наприклад 03.2026" aria-describedby="c-last-hint" class="min-h-12 w-full min-w-0 rounded-sm border border-line-strong bg-white px-4 text-ink placeholder:text-stone" />
          <span id="c-last-hint" class="t-caption text-fg-mute">Місяць і рік з ветпаспорта. Не пам’ятаєте — залиште порожнім.</span></label>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <Button href="/klub/" icon="send" class="!whitespace-normal py-2 text-left">Надсилати нагадування в Telegram</Button>
        </div>
      </form>
    </div>

    <div class="grid content-start gap-6" aria-live="polite">
      <ol class="cal grid" data-care-list>
        <li class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 border-t border-ink py-4"><span class="font-semibold">раз на рік</span><span><strong class="block">Щорічна ревакцинація</strong><span class="text-fg-mute">комплексна вакцина і сказ</span></span></li>
        <li class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 border-t border-ink py-4"><span class="font-semibold">за 10 днів</span><span><strong class="block">Обробка від глистів</strong><span class="text-fg-mute">перед кожним щепленням</span></span></li>
        <li class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 border-y border-ink py-4"><span class="font-semibold">бер.–жовт.</span><span><strong class="block">Обробка від кліщів і бліх</strong><span class="text-fg-mute">щомісяця в сезон</span></span></li>
      </ol>
      <BotMessage time="10:00" buttons={['Записати', 'Інший час']}><p data-care-bot>Барсику через 14 днів щорічна ревакцинація. Для клубу знижка {club.discount} %. Записати на суботу о 10:30?</p></BotMessage>
      <p class="flex items-start gap-2 text-[0.875rem] text-fg-mute"><Icon name="info" class="mt-px size-4" />Типовий план нагадувань. Схему щеплень визначає лікар на огляді.</p>
    </div>
  </div>
</section>
