  .frame-desk { position: relative; aspect-ratio: 1280 / 800; }
  .frame-desk iframe { position: absolute; left: 0; top: 0; transform-origin: 0 0; border: 0; }
  .frame-mob { width: min(375px, 100%); height: 760px; }
  .frame-mob iframe { width: 100%; height: 100%; border: 0; }
</style>
<script is:inline>
  (function () {
    var fit = function () { document.querySelectorAll('.frame-desk').forEach(function (w) { var f = w.querySelector('iframe'); f.style.transform = 'scale(' + w.clientWidth / 1280 + ')'; }); };
